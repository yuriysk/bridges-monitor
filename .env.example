# Секрети для локальної розробки. Скопіюйте у .env (він у .gitignore) і заповніть.
# На сервері замість .env — Docker secrets: окремий файл на кожну змінну
# в /run/secrets/<ІМ'Я_ЗМІННОЇ>, вміст файлу — значення.
# Несекретні налаштування — у config.toml (зразок: config.example.toml).

# Повітряні тривоги (провайдер обирається в config.toml, [alerts] provider)
BM_ALERTS__TOKEN=

# Джерела заторів: заповнюйте лише для провайдерів, увімкнених у config.toml [traffic.*]
# BM_TRAFFIC__TOMTOM__TOKEN=
# BM_TRAFFIC__HERE__TOKEN=
# BM_TRAFFIC__GOOGLE__TOKEN=
# BM_TRAFFIC__MAPBOX__TOKEN=
